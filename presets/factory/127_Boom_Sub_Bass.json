    "osc.a.wave": "Sine",
    "osc.a.phaseMode": "Retrigger",
    "filter.character": "Clean",
    "filter.mode": "LP12",
    "filter.cutoff": 1000,
    "filter.keyTrack": 40,
    "amp.attack": 0.5,
    "amp.decay": 1500,
    "amp.sustain": 0,
    "amp.release": 120,
    "transient.enabled": true,
    "transient.mode": "Both",
    "transient.amount": 100,
    "transient.duration": 60,
    "transient.noiseColor": 20,
    "transient.pitchSnap": 24,
    "voice.mode": "Mono",
    "voice.glide": 60,
    "fx.drive.enabled": true,
    "fx.drive.type": "Soft Clip",
    "fx.drive.drive": 50,
    "fx.drive.tone": 45,
    "fx.drive.mix": 85,
    "fx.imager.enabled": true,
    "fx.imager.width": 40,
    "fx.imager.monoBass": true,
    "preset.level": 4.0
  },
