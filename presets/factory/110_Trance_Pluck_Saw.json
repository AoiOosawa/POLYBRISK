    "osc.b.level": 30,
    "osc.b.phaseMode": "Free",
    "filter.character": "Clean",
    "filter.mode": "LP24",
    "filter.cutoff": 500,
    "filter.resonance": 10,
    "filter.envAmount": 70,
    "filter.keyTrack": 45,
    "filter.velocity": 30,
    "filterEnv.attack": 0.5,
    "filterEnv.decay": 260,
    "filterEnv.sustain": 0,
    "filterEnv.release": 220,
    "amp.attack": 1,
    "amp.decay": 420,
    "amp.sustain": 0,
    "amp.release": 240,
