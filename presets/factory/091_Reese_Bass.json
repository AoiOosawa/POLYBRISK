    "fx.phaser.rate": 0.15,
    "fx.phaser.depth": 50,
    "fx.phaser.feedback": 30,
    "fx.phaser.mix": 35,
    "fx.imager.enabled": true,
    "fx.imager.width": 110,
    "fx.imager.monoBass": true,
    "preset.level": 1.0
