          "curve": "linear"
        }
      ]
    },
    {
      "index": 2,
      "name": "Detune",
      "mappings": [
        {
          "target": "osc.a.detune",
          "deltaMin": -0.25,
          "deltaMax": 0.4,
          "curve": "linear"
        },
        {
          "target": "osc.b.fine",
