    "Motion",
    "Mono",
    "Dry"
  ],
  "author": "POLYBRISK",
  "description": "Detuned saws that beat against each other, with a slow phaser moving through the top. The growling held bass of drum and bass and garage.",
  "parameters": {
    "osc.a.enabled": true,
    "osc.a.wave": "Saw",
    "osc.a.unisonVoices": 2,
    "osc.a.detune": 35,
    "osc.a.spread": 40,
    "osc.a.phaseMode": "Free",
    "osc.b.enabled": true,
    "osc.b.wave": "Saw",
    "osc.b.fine": 9,
    "osc.b.level": 80,
    "osc.b.phaseMode": "Free",
    "filter.character": "Clean",
    "filter.mode": "LP24",
    "filter.cutoff": 600,
    "filter.resonance": 10,
    "filter.keyTrack": 40,
    "amp.attack": 4,
    "amp.decay": 600,
    "amp.sustain": 95,
    "amp.release": 160,
    "voice.mode": "Legato",
    "voice.glide": 90,
    "fx.drive.enabled": true,
    "fx.drive.type": "Soft Clip",
    "fx.drive.drive": 30,
    "fx.drive.mix": 70,
    "fx.phaser.enabled": true,
