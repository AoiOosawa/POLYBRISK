{
  "schemaVersion": 1,
  "id": "56532633-0fe8-5ee1-8e17-38255e9530bc",
  "name": "Anthem Saw",
  "category": "SuperSAW",
  "tags": [
    "Bright",
    "Big",
    "Wide"
  ],
  "author": "POLYBRISK",
  "description": "Wide two-octave supersaw for big chorus chords. Plate reverb and a touch of chorus.",
  "parameters": {
    "osc.a.enabled": true,
    "osc.a.wave": "SuperSAW",
    "osc.a.unisonVoices": 7,
    "osc.a.detune": 40,
    "osc.a.spread": 85,
    "osc.a.phaseMode": "Free",
    "osc.b.enabled": true,
    "osc.b.wave": "SuperSAW",
    "osc.b.octave": 1,
    "osc.b.unisonVoices": 7,
    "osc.b.detune": 32,
    "osc.b.spread": 100,
    "osc.b.level": 50,
    "osc.b.phaseMode": "Free",
    "filter.character": "Clean",
    "filter.mode": "LP12",
    "filter.cutoff": 9000,
    "filter.keyTrack": 30,
    "amp.attack": 6,
    "amp.decay": 800,
    "amp.sustain": 85,
    "amp.release": 380,
    "fx.chorus.enabled": true,
    "fx.chorus.type": "Wide",
    "fx.chorus.rate": 0.5,
    "fx.chorus.depth": 40,
    "fx.chorus.mix": 25,
    "fx.eq.enabled": true,
    "fx.eq.lowGain": -2,
    "fx.eq.highGain": 3,
    "fx.imager.enabled": true,
    "fx.imager.width": 120,
    "fx.imager.monoBass": true,
    "fx.reverb.enabled": true,
    "fx.reverb.type": "Plate",
    "fx.reverb.decay": 2.2,
    "fx.reverb.mix": 22,
    "fx.reverb.tone": 65,
    "preset.level": -1.0
  },
  "macros": [
    {
      "index": 1,
      "name": "Bright",
      "mappings": [
        {
          "target": "filter.cutoff",
          "deltaMin": -0.35,
          "deltaMax": 0.2,
          "curve": "linear"
        },
        {
          "target": "fx.eq.highGain",
          "deltaMin": -0.1,
          "deltaMax": 0.15,
          "curve": "linear"
        }
      ]
    },
    {
      "index": 2,
      "name": "Detune",
      "mappings": [
        {
          "target": "osc.a.detune",
          "deltaMin": -0.3,
          "deltaMax": 0.35,
          "curve": "linear"
        },
        {
          "target": "osc.b.detune",
          "deltaMin": -0.25,
          "deltaMax": 0.3,
          "curve": "linear"
        },
        {
          "target": "osc.a.unisonMix",
          "deltaMin": -0.2,
          "deltaMax": 0.25,
          "curve": "linear"
        },
        {
          "target": "osc.b.unisonMix",
          "deltaMin": -0.2,
          "deltaMax": 0.25,
          "curve": "linear"
        }
      ]
    },
