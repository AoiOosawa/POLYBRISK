      "index": 3,
      "name": "Space",
      "mappings": [
        {
          "target": "fx.reverb.mix",
          "deltaMin": -0.2,
          "deltaMax": 0.35,
          "curve": "linear"
        },
        {
          "target": "fx.reverb.decay",
          "deltaMin": -0.1,
          "deltaMax": 0.25,
          "curve": "linear"
        }
      ]
    },
    {
      "index": 4,
      "name": "Release",
      "mappings": [
        {
          "target": "amp.release",
