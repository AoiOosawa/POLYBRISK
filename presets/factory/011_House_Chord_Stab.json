    "osc.b.semitone": 7,
    "osc.b.level": 60,
    "osc.b.phaseMode": "Retrigger",
    "filter.character": "Analog",
    "filter.mode": "LP24",
    "filter.cutoff": 1200,
    "filter.resonance": 25,
    "filter.envAmount": 35,
    "filter.keyTrack": 40,
    "filter.velocity": 30,
    "filterEnv.attack": 0.5,
