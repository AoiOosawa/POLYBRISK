{
  "schemaVersion": 1,
  "id": "9ddc70be-abe3-55b3-8227-d0ce2f5fa885",
  "name": "Dice Stab",
  "category": "Stab / Chord Hit",
  "tags": [
    "Bright",
    "Wide",
    "Motion"
  ],
  "author": "POLYBRISK",
  "description": "Every chord lands at a different brightness: a sample-and-hold LFO resets the filter on each hit, and dotted echoes follow.",
  "parameters": {
    "osc.a.enabled": true,
    "osc.a.wave": "Saw",
    "osc.a.unisonVoices": 3,
    "osc.a.detune": 18,
    "osc.a.spread": 65,
    "osc.a.phaseMode": "Retrigger",
    "osc.b.enabled": true,
    "osc.b.wave": "Pulse",
    "osc.b.pulseWidth": 35,
    "osc.b.octave": 1,
    "osc.b.level": 40,
    "osc.b.phaseMode": "Retrigger",
    "filter.character": "Analog",
    "filter.mode": "LP24",
    "filter.cutoff": 1300,
    "filter.resonance": 24,
    "filter.envAmount": 30,
    "filter.keyTrack": 45,
    "filterEnv.attack": 0.5,
    "filterEnv.decay": 180,
    "filterEnv.sustain": 0,
    "filterEnv.release": 140,
    "amp.attack": 0.5,
    "amp.decay": 320,
    "amp.sustain": 0,
    "amp.release": 140,
    "lfo.wave": "S&H",
    "lfo.rate": 7,
    "lfo.cutoff": 38,
    "fx.delay.enabled": true,
    "fx.delay.mode": "Stereo",
    "fx.delay.division": "1/4 D",
    "fx.delay.feedback": 50,
    "fx.delay.tone": 45,
    "fx.delay.mix": 26,
    "fx.reverb.enabled": true,
    "fx.reverb.type": "Plate",
    "fx.reverb.decay": 1.2,
    "fx.reverb.mix": 8,
    "preset.level": 0.5
  },
  "macros": [
    {
      "index": 1,
      "name": "Dice",
      "mappings": [
        {
          "target": "lfo.cutoff",
          "deltaMin": -0.3,
          "deltaMax": 0.2,
          "curve": "linear"
        }
      ]
    },
    {
      "index": 2,
      "name": "Bright",
      "mappings": [
        {
          "target": "filter.cutoff",
          "deltaMin": -0.2,
          "deltaMax": 0.25,
          "curve": "linear"
        }
      ]
    },
    {
      "index": 3,
      "name": "Length",
      "mappings": [
        {
          "target": "amp.decay",
          "deltaMin": -0.15,
          "deltaMax": 0.3,
          "curve": "linear"
        }
      ]
    },
    {
      "index": 4,
      "name": "Echo",
      "mappings": [
        {
          "target": "fx.delay.mix",
          "deltaMin": -0.25,
          "deltaMax": 0.25,
          "curve": "linear"
        },
        {
          "target": "fx.delay.feedback",
          "deltaMin": -0.3,
          "deltaMax": 0.3,
          "curve": "linear"
        }
      ]
    }
  ]
}
