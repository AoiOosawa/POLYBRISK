{
  "schemaVersion": 1,
  "id": "36457dfa-72d3-5f09-a600-8b23f5a6145b",
  "name": "Reverb Throw Stab",
  "category": "Stab / Chord Hit",
  "tags": [
    "Warm",
    "Big",
    "FX",
    "Wide"
  ],
  "author": "POLYBRISK",
  "description": "A dry, short hit into a long hall. Play one chord and let five seconds of reverb answer it.",
  "parameters": {
    "osc.a.enabled": true,
    "osc.a.wave": "SuperSAW",
    "osc.a.unisonVoices": 7,
    "osc.a.detune": 30,
    "osc.a.spread": 90,
    "osc.a.unisonMix": 64,
    "osc.a.phaseMode": "Retrigger",
    "osc.b.enabled": true,
    "osc.b.wave": "Square",
    "osc.b.octave": -1,
    "osc.b.level": 40,
    "osc.b.phaseMode": "Retrigger",
    "filter.character": "Punch",
    "filter.mode": "LP24",
    "filter.cutoff": 1300,
    "filter.resonance": 12,
    "filter.envAmount": 50,
    "filter.keyTrack": 40,
    "filterEnv.attack": 0.5,
    "filterEnv.decay": 170,
    "filterEnv.sustain": 0,
    "filterEnv.release": 120,
    "amp.attack": 0.5,
    "amp.decay": 260,
    "amp.sustain": 0,
    "amp.release": 120,
    "fx.reverb.enabled": true,
    "fx.reverb.type": "Hall",
    "fx.reverb.size": 80,
    "fx.reverb.decay": 5.0,
    "fx.reverb.preDelay": 60,
    "fx.reverb.tone": 55,
    "fx.reverb.mix": 40,
    "preset.level": 4.5
  },
  "macros": [
    {
      "index": 1,
      "name": "Throw",
      "mappings": [
        {
          "target": "fx.reverb.mix",
          "deltaMin": -0.35,
          "deltaMax": 0.2,
          "curve": "linear"
        },
        {
          "target": "fx.reverb.decay",
          "deltaMin": -0.2,
          "deltaMax": 0.2,
          "curve": "linear"
        }
      ]
    },
    {
      "index": 2,
      "name": "Bright",
      "mappings": [
        {
          "target": "filter.cutoff",
          "deltaMin": -0.2,
          "deltaMax": 0.25,
          "curve": "linear"
        }
      ]
    },
    {
      "index": 3,
      "name": "Length",
      "mappings": [
        {
          "target": "amp.decay",
          "deltaMin": -0.1,
          "deltaMax": 0.3,
          "curve": "linear"
        }
      ]
    },
    {
      "index": 4,
      "name": "Pre-Delay",
      "mappings": [
        {
          "target": "fx.reverb.preDelay",
          "deltaMin": -0.3,
          "deltaMax": 0.5,
          "curve": "linear"
        }
      ]
    }
  ]
}
